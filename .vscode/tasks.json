			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Install Node.js LTS",
			"type": "shell",
			"command": "winget",
			"args": [
				"install",
				"--id",
				"OpenJS.NodeJS.LTS",
				"--exact",
				"--accept-package-agreements",
				"--accept-source-agreements"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
