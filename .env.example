# Babylon Budget - Environment Configuration
# Add your Neon PostgreSQL connection string from https://console.neon.tech
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-YOUR-ENDPOINT.us-east-2.aws.neon.tech/neondb?sslmode=require"

# API Port
PORT=4000

# Secret used to sign JSON Web Tokens
JWT_SECRET="babylon_budget_jwt_secret_key_change_me"
